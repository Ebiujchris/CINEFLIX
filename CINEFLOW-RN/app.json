{
  "expo": {
    "owner": "ebiujchris",
    "name": "Cineflix",
    "slug": "cineflix",
    "scheme": "cineflix",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cineflix-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/cineflix-icon.png",
      "backgroundColor": "#0b0b0b",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.cineflix.app",
      "minSdkVersion": 26,
      "targetSdkVersion": 34,
      "adaptiveIcon": {
        "foregroundImage": "./assets/cineflix-icon.png",
        "backgroundColor": "#e50914"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.cineflix.app",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/cineflix-icon.png"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/f62a41cd-25c1-4886-91fa-1cbee691dbaa",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    },
    "extra": {
      "eas": {
        "projectId": "f62a41cd-25c1-4886-91fa-1cbee691dbaa"
      }
    },
    "plugins": [
      "expo-video"
    ]
  }
}
