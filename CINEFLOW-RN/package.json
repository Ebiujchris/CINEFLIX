{
  "name": "cineflix-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.25",
    "expo-secure-store": "^57.0.4",
    "expo-updates": "^57.0.23",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "babel-plugin-syntax-hermes-parser": "0.36.1",
    "hermes-parser": "0.36.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "eas build --platform android --profile preview",
    "build:prod": "eas build --platform android --profile production",
    "submit:apk": "eas submit --platform android --profile production",
    "update": "eas update --branch production --message 'Update app'",
    "update:preview": "eas update --branch preview --message 'Preview update'"
  },
  "private": true
}
